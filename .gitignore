# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Predictions & results (generated)
predictions/*.json
results/*.json
output/

# Calibration state caches (generated per-league)
scripts/references/.calibration_state*.json

# Environment
.env
.venv*/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Skill artifacts (optional)
*.bak
SKILL.md.bak-*
docs/web/logs/*_try*.log
docs/web/logs/*.out
docs/web/logs/*.tail
docs/web/logs/*.killed
web/.data/
docs/web/logs/*.log
docs/web/logs/*.job
docs/web/logs/*.done
docs/web/logs/PIPELINE.*
.fastapicloud/
docs/web/logs/*.attempts
docs/web/logs/*.paused
deploy/

# Agent 本地工作目录（不入版本库）
.agents/
.omp-logs/

# 篮球引擎运行时产物（种子文件保持追踪）
data/nba_elo.json
scripts/bball_data/

# 运行期中间件（predict/backtest 产物；历史训练样本已并入 references/historical_past_matches.json）
scripts/predictions/*.json
scripts/results/*.json
# 运行期日志（observability: runtime.log + events.jsonl + rotate backups）
scripts/logs/

# AI 分析产物（ai_analyze 异步 job 输出）
predictions/ai_analysis/

# collector runtime lock
.collector.lock

# 凭据备份（勿入库）
.env.bak-*

# 结果文件轮转备份（league-daily-predict 运行时按日期戳归档）
scripts/results/.bak-*/

# 运行期 ELO 状态（服务每轮重写；缺失时 load_elo_ratings() 回退 FIFA 冷启动）
references/.elo_ratings.json

# R20-1 运行期 retrain 产物（每日被训练覆盖 → 不进 commit，但 retrain 会重新生成）
scripts/references/ml_model_*.json
scripts/references/historical_past_matches.json

# 测试产物（pytest 缓存 + coverage 数据；不属业务产物）
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# stress_runs 产物快照（每次压测会变；工具脚本 *.ps1 仍 commit 进仓）
stress_runs/*.txt
