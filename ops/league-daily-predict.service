[Unit]
Description=league-web 每日全量预测（足球 + NBA + AI 富化）
After=network.target league-web.service
Wants=league-web.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/work/sports-lottery
ExecStart=/home/ubuntu/work/sports-lottery/ops/league-daily-predict.sh
Environment=LEAGUE_API_BASE=http://127.0.0.1:8077/api/v1
TimeoutStartSec=14400
Nice=10

[Install]
WantedBy=multi-user.target
