# ============================================================
# league-v2 环境变量清单（唯一出处：Web 层 + 数据源 key + 源开关）
# 复制为 .env 后填写真实值。仓库内任何文件不得出现真实敏感值；本文件值一律占位。
# 未设置的键全部有安全默认值（见 web/config.py、scripts/config.py），可裸启动。
# 优先级：真实环境变量 > repo/.env（scripts/core/constants.py::_load_dotenv 只在键未设时填）。
# ============================================================

# --- 服务 ---
# 监听地址与端口（开发用；云端部署由平台注入，可忽略）
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- 会话认证（单账号）---
# 部署时改为强口令；placeholder 仅用于本地/测试。
AUTH_USERNAME=admin
AUTH_PASSWORD=<your-strong-password>

# 会话 TTL 秒（默认 12h = 43200）
SESSION_TTL_SECONDS=43200
# 访问时惰性清理过期会话行（1 开 / 0 关）
SESSION_CLEANUP_ON_ACCESS=1

# --- 登录限速 ---
# 连续失败 N 次后锁定窗口 W 秒（默认 5 次 / 600 秒）
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=600

# --- Cookie / CORS ---
# 部署在 https 后置 1：cookie 加 Secure、CORS 只放行 https 来源
USE_HTTPS=0
# 逗号分隔的允许来源；留空 = 不启用 CORS（同源最安全）
CORS_ORIGINS=

# --- 会话存储 ---
# SQLite 会话库路径；默认 web/.data/sessions.db（gitignore 已排除）
SESSION_DB_PATH=

# --- 数据源 key（默认表见 scripts/config.py::DEFAULTS，key 名唯一出处也是它）---
# API-Football：免费档 100 req/天；EPL 伤停/阵容/H2H enrichment 默认关闭
API_FOOTBALL_KEY=<your-api-football-key>
# 只读 enrichment 开关；开启前确认额度与 fixture/team ID 映射
API_FOOTBALL_ENRICH_ENABLED=0
API_FOOTBALL_ENABLED=0
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_MINUTE_LIMIT=10
# football-data.org：免费档限速 10 req/min，ingest 回填用
FOOTBALL_DATA_API_KEY=<your-football-data-key>
# The Odds API（收费，外部盘口）：篮球预测用，默认关闭，见 LEAGUE_SOURCE_ODDS_API
# 启用篮球需要**两个变量同时**设置（名字不一致是历史遗留）：
#   - NBA_API_KEY：config 层 SourcePolicy 的守卫变量（scripts/config.py DEFAULTS）
#   - ODDS_API_KEY：v1 冻结代码 scripts/bball/run.py 实际读的变量
# 只设一个会出现「守卫说可用、脚本说没 key」的不一致，故两个都填同一个值。
NBA_API_KEY=<your-the-odds-api-key>
ODDS_API_KEY=<your-the-odds-api-key>

# --- LLM（仅 AI 富化/队名翻译使用；无 key 时安全降级，不影响预测）---
# 当前兼容 OpenAI 风格接口；默认 api_base/model 见 ai/llm_client.py
LLM_API_KEY=<your-llm-api-key>
LLM_API_BASE=https://api.agnes-ai.cn/v1
LLM_MODEL=agnes-2.5-flash
# 兼容旧 Gemini 配置：未设置 LLM_API_KEY 时读取 GEMINI_API_KEY
# GEMINI_API_KEY=<your-gemini-api-key>

# --- PostgreSQL（三库角色分工见 docs/db/infra_p0_2_schemas.sql）---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=league
DB_ING_USER=<ing-role>
DB_ING_PASSWORD=<ing-password>
DB_APP_USER=<app-role>
DB_APP_PASSWORD=<app-password>
DB_RO_USER=<ro-role>
DB_RO_PASSWORD=<ro-password>
# 三角色 DSN（scripts/store/pg.py 按角色名取；不填则由上面的分量拼）
DSN_ING=postgresql://<ing-user>:<pw>@127.0.0.1:5432/league
DSN_APP=postgresql://<app-user>:<pw>@127.0.0.1:5432/league
DSN_RO=postgresql://<ro-user>:<pw>@127.0.0.1:5432/league

# --- 源开关与配额上限（README §2-D9；默认值见 scripts/config.py::DEFAULTS，下列全注释＝保持默认）---
# 命名：LEAGUE_SOURCE_<SOURCE>=on|off；LEAGUE_QUOTA_CAP_<SOURCE>=非负整数（<SOURCE> 用大写源名）
# 关闭＝零副作用：不发请求、不写 raw.*、不记 ops.quota_ledger
# LEAGUE_SOURCE_API_FOOTBALL=on
# LEAGUE_QUOTA_CAP_API_FOOTBALL=100
# LEAGUE_SOURCE_FOOTBALL_DATA=on
# LEAGUE_QUOTA_CAP_FOOTBALL_DATA=30
# LEAGUE_SOURCE_ODDS_API=off
# LEAGUE_QUOTA_CAP_ODDS_API=0
# 付费源单次放行：LEAGUE_ALLOW_PAID=on，或用 run_backfill --allow-paid（只写本次进程 env，不落 .env）
# LEAGUE_ALLOW_PAID=off
